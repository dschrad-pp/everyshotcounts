group Coachdao;

selectByUsername(username) ::= <<
SELECT DISTINCT
    u.id                   AS id,
    u.email                AS email,
    u.user_alias           AS userAlias,
    u.username             AS username,
    u.contact_id           AS contactId,
    u.keycloak_id          AS keycloakId,
    u.avatar_byte_array    AS avatarByteArray,
    u.avatar_mime_type     AS avatarMimeType,
    u.version              AS version,
    c.first_name           AS firstName,
    c.last_name            AS lastName,
    r.name                 AS roleName
FROM
    t_user u
JOIN
    t_contact c ON u.contact_id = c.id
JOIN
    t_user_role_xref ur ON u.id = ur.user_id
JOIN
    t_role r ON ur.role_id = r.id
WHERE
    u.username = :username
    AND r.name = 'COACH'
;
>>

selectById(id) ::= <<
SELECT
    u.id                   AS id,
    u.email                AS email,
    u.user_alias           AS userAlias,
    u.username             AS username,
    u.contact_id           AS contactId,
    u.keycloak_id          AS keycloakId,
    u.avatar_byte_array    AS avatarByteArray,
    u.avatar_mime_type     AS avatarMimeType,
    u.version              AS version,
    c.first_name           AS firstName,
    c.last_name            AS lastName,
    r.name                 AS roleName
FROM
    t_user u
JOIN
    t_contact c ON u.contact_id = c.id
JOIN
    t_user_role_xref ur ON u.id = ur.user_id
JOIN
    t_role r ON ur.role_id = r.id
WHERE
    u.id = :id
    AND r.name = 'COACH'
;
>>

selectAllAthletesAssignedToCoach(coachId) ::= <<
SELECT DISTINCT
    au.id                  AS au_userId,
    au.email               AS au_email,
    au.user_alias          AS au_userAlias,
    au.username            AS au_username,
    ac.id                  AS ac_id,   
    ac.first_name          AS ac_firstName,
    ac.last_name           AS ac_lastName,
    ac.email               AS ac_email,
    ac.telephone           AS ac_telephone,
    ac.birth_date          AS ac_birthDate,
    up.property_key        AS property_key,
    up.property_value      AS property_value
FROM
    t_user au
JOIN
    t_contact ac ON au.contact_id = ac.id
LEFT JOIN
    t_user_property up ON au.id = up.user_id
JOIN
    t_user_role_xref aur ON au.id = aur.user_id
JOIN
    t_role ar ON aur.role_id = ar.id
JOIN
    t_team_user_xref atux ON au.id = atux.user_id
JOIN
    t_team t ON atux.team_id = t.id
JOIN
    t_team_user_xref ctux ON t.id = ctux.team_id
JOIN
    t_user cu ON ctux.user_id = cu.id
JOIN
    t_user_role_xref cur ON cu.id = cur.user_id
JOIN
    t_role cr ON cur.role_id = cr.id
WHERE
    ar.name = 'ATHLETE'
    AND cr.name = 'COACH'
    AND cu.id = :coachId
ORDER BY au.username
;
>>