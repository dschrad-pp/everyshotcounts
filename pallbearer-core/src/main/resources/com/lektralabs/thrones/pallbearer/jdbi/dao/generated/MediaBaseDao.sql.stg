group MediaBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_media
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_media
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_media (
            id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :name
          , :description
          , :contentUrl
          , :statusCode
          , :mimeType
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_media
        SET name = :name
          , description = :description
          , content_url = :contentUrl
          , status_code = :statusCode
          , mime_type = :mimeType
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_media WHERE id = :id
>>
