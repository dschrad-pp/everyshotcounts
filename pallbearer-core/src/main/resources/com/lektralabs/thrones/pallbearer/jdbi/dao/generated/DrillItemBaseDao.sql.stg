group DrillItemBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , drill_group_id
          , name
          , description
          , media_id
          , level_index
          , drill_item_order
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , order_index
          , team_id
          , shots_max
       FROM t_drill_item
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_drill_item
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_drill_item (
            id
          , drill_group_id
          , name
          , description
          , media_id
          , level_index
          , drill_item_order
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , team_id
          , shots_max
     ) VALUES (
            :id
          , :drillGroupId
          , :name
          , :description
          , :mediaId
          , :levelIndex
          , :drillItemOrder
          , :passingScore
          , :visibilityCode
          , :allowRetryCode
          , :retryMax
          , :timeLimitMs
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
          , :levelTest
          , :teamId
          , :shotsMax
     )
>>

update() ::= <<
     UPDATE t_drill_item
        SET drill_group_id = :drillGroupId
          , name = :name
          , description = :description
          , media_id = :mediaId
          , level_index = :levelIndex
          , drill_item_order = :drillItemOrder
          , passing_score = :passingScore
          , visibility_code = :visibilityCode
          , allow_retry_code = :allowRetryCode
          , retry_max = :retryMax
          , time_limit_ms = :timeLimitMs
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
          , level_test = :levelTest
          , team_id = :teamId
          , shots_max = :shotsMax
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_drill_item WHERE id = :id
>>
