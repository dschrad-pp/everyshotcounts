group CrmRegistrationDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

selectByRegistrationId() ::= <<
     SELECT registration_id
          , user_id
          , username
          , email
          , first_name
          , last_name
          , phone AS phone_number
          , role
          , team_id
          , payment_status
          , last_updated
          , created_at
          , updated_at
       FROM t_crm_registration
      WHERE registration_id = :registrationId
>>

selectAll() ::= <<
     SELECT registration_id
          , user_id
          , username
          , email
          , first_name
          , last_name
          , phone AS phone_number
          , role
          , team_id
          , payment_status
          , last_updated
          , created_at
          , updated_at
       FROM t_crm_registration
      ORDER BY last_updated DESC
>>

insert() ::= <<
     INSERT INTO t_crm_registration (
          registration_id
          , user_id
          , username
          , email
          , first_name
          , last_name
          , phone
          , role
          , team_id
          , payment_status
          , last_updated
     ) VALUES (
          :registrationId
          , :userId
          , :username
          , :email
          , :firstName
          , :lastName
          , :phoneNumber
          , :role
          , :teamId
          , :paymentStatus
          , :lastUpdated
     )
>>


selectByUsername() ::= <<
     SELECT registration_id, user_id, username, email, first_name, last_name,
            phone AS phone_number, role, team_id, payment_status, last_updated, created_at, updated_at
       FROM t_crm_registration
      WHERE lower(username) = lower(:username)
      ORDER BY last_updated DESC
      LIMIT 1
>>

selectByEmail() ::= <<
     SELECT registration_id, user_id, username, email, first_name, last_name,
            phone AS phone_number, role, team_id, payment_status, last_updated, created_at, updated_at
       FROM t_crm_registration
      WHERE lower(email) = lower(:email)
      ORDER BY last_updated DESC
      LIMIT 1
>>


update() ::= <<
     UPDATE t_crm_registration
        SET user_id = :userId
          , username = :username
          , email = :email
          , first_name = :firstName
          , last_name = :lastName
          , phone = :phoneNumber
          , role = :role
          , team_id = :teamId
          , payment_status = :paymentStatus
          , last_updated = :lastUpdated
          , updated_at = CURRENT_TIMESTAMP
      WHERE registration_id = :registrationId
>>
