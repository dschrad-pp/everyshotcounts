group LeagueAppsRegistrationDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

selectByRegistrationId() ::= <<
     SELECT registration_status
          , parent_email
          , registration_start_date
          , group_id
          , payment_plan_status
          , master_program_id
          , last_updated
          , price
          , program_name
          , registration_id
          , season
          , id
          , state
          , email
          , outstanding_balance
          , is_staff
          , created
          , parent_user_id
          , waiver_accepted_timestamp
          , first_name
          , parent_first_name
          , group_name
          , user_profile_id
          , user_type
          , last_name
          , role
          , gender
          , city
          , site_name
          , parent_phone
          , amount_paid
          , registration_end_date
          , program_state
          , program_end_date
          , current_grade_level
          , last_payment_date
          , payment_status
          , payment_plan
          , program_type
          , parent_last_name
          , address_1
          , total_amount_due
          , user_name
          , user_id
          , birth_date
          , is_co_captain
          , sport_id
          , phone
          , current_club_team_affiliation
          , master_program_name
          , general_terms_of_service
          , team_id
          , current_school_attending
          , invoice_id
          , program_start_date
          , sport
          , program_id
       FROM t_league_apps_registration
      WHERE registration_id = :registrationId
>>
