group LikeBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , user_id
          , like_type
          , status_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_like
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_like
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_like (
            id
          , user_id
          , like_type
          , status_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :userId
          , :likeType
          , :statusCode
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_like
        SET user_id = :userId
          , like_type = :likeType
          , status_code = :statusCode
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_like WHERE id = :id
>>
