group DrillBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , drill_item_id
          , user_id
          , media_id
          , drill_status
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , attempts_detected
          , attempts_reported
          , makes_detected
          , makes_reported
       FROM t_drill
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_drill
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_drill (
            id
          , drill_item_id
          , user_id
          , media_id
          , drill_status
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , attempts_detected
          , attempts_reported
          , makes_detected
          , makes_reported
     ) VALUES (
            :id
          , :drillItemId
          , :userId
          , :mediaId
          , :drillStatus
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
          , :attemptsDetected
          , :attemptsReported
          , :makesDetected
          , :makesReported
     )
>>

update() ::= <<
     UPDATE t_drill
        SET drill_item_id = :drillItemId
          , user_id = :userId
          , media_id = :mediaId
          , drill_status = :drillStatus
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version
          , attempts_detected = :attemptsDetected
          , attempts_reported = :attemptsReported
          , makes_detected = :makesDetected
          , makes_reported = :makesReported
      WHERE id = :id
        AND version = :currentVersion
>>

delete() ::= <<
      DELETE FROM t_drill WHERE id = :id
>>
