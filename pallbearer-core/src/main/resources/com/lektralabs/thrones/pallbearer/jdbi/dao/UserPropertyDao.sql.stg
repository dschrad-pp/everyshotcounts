group UserPropertyDao;

select() ::= <<
     SELECT id
          , user_id
          , property_key
          , property_value
       FROM t_user_property
      WHERE id = :id
>>

selectByUserId() ::= <<
     SELECT id
          , user_id
          , property_key
          , property_value
       FROM t_user_property
      WHERE user_id = :userId
>>

selectByUserIds(userIds) ::= <<
     SELECT id
          , user_id
          , property_key
          , property_value
       FROM t_user_property
      WHERE user_id IN (<userIds>)
>>

selectByKey() ::= <<
     SELECT id
          , user_id
          , property_key
          , property_value
       FROM t_user_property
      WHERE user_id = :userId
        AND lower(property_key) = lower(:propertyKey)
>>

insert() ::= <<
     INSERT INTO t_user_property (
            id
          , user_id
          , property_key
          , property_value
     ) VALUES (
            :id
          , :userId
          , :propertyKey
          , :propertyValue
     )
>>

update() ::= <<
     UPDATE t_user_property
        SET user_id = :userId
          , property_key = :propertyKey
          , property_value = :propertyValue
      WHERE id = :id
>>

delete() ::= <<
      DELETE FROM t_user_property WHERE id = :id
>>
