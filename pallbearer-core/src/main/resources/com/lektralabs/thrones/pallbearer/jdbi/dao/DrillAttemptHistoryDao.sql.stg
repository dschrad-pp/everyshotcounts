group DrillAttemptHistoryDao;

insertHistory() ::=
<<
INSERT INTO t_drill_attempt_history (
    id,
    user_id,
    drill_id,
    attempts_detected,
    attempts_reported,
    makes_detected,
    makes_reported,
    recorded_at,
    started_at,
    version,
    media_id,
    attempt_local_id,
    attempt_number,
    hot_streak,
    cold_streak
) VALUES (
    :id,
    :userId,
    :drillId,
    :attemptsDetected,
    :attemptsReported,
    :makesDetected,
    :makesReported,
    COALESCE(:recordedAt, NOW()),
    :startedAt,
    :version,
    :mediaId,
    :attemptLocalId,
    :attemptNumber,
    :hotStreak,
    :coldStreak
)
ON CONFLICT (attempt_local_id) DO NOTHING;
>>

updateMediaId() ::=
<<
UPDATE t_drill_attempt_history
   SET media_id = :mediaId
 WHERE drill_id = :drillId
   AND version = :version
>>

updateLatestAttemptMediaId() ::=
<<
UPDATE t_drill_attempt_history
   SET media_id = :mediaId
 WHERE drill_id = :drillId
   AND attempt_number = (SELECT MAX(attempt_number) FROM t_drill_attempt_history WHERE drill_id = :drillId)
>>

updateMediaIdByAttemptLocalId() ::=
<<
UPDATE t_drill_attempt_history
   SET media_id = :mediaId
 WHERE attempt_local_id = :attemptLocalId
>>

findByDrillId() ::=
<<
SELECT *
FROM t_drill_attempt_history
WHERE drill_id = :drillId
ORDER BY recorded_at DESC;
>>

findByUserId() ::=
<<
SELECT *
FROM t_drill_attempt_history
WHERE user_id = :userId
ORDER BY recorded_at DESC;
>>

findByDrillIdAndUserId() ::=
<<
SELECT *
FROM t_drill_attempt_history
WHERE drill_id = :drillId
  AND user_id = :userId
ORDER BY recorded_at DESC;
>>

getAttemptCount() ::=
<<
SELECT COUNT(*)
FROM t_drill_attempt_history
WHERE user_id = :userId
  AND drill_id = :drillId;
>>

<!
  Athlete activity heatmap. Counts completion submissions per calendar day,
  bucketed in the athlete's requested IANA timezone (:tz).

  recorded_at is 'timestamp without time zone' holding UTC wall-clock, so
  (recorded_at AT TIME ZONE 'UTC' AT TIME ZONE :tz) shifts it to local wall-clock
  before truncating to a date: a completion at 11:40pm local lands on that local
  day, not the UTC day.

  The recorded_at BETWEEN bounds are the [from-start-local, to-end-local] window
  expressed back in UTC. They are an exact equivalent of "local date in
  [:fromDate, :toDate]" (bucketing is monotonic in the instant) and, unlike the
  functional expression, are sargable against idx_drill_attempt_history_user_recorded.
!>
activityByDay() ::=
<<
SELECT to_char((recorded_at AT TIME ZONE 'UTC' AT TIME ZONE :tz)::date, 'YYYY-MM-DD') AS date,
       COUNT(*) AS completed_count
FROM t_drill_attempt_history
WHERE user_id = :userId
  AND recorded_at BETWEEN
        ((:fromDate)::timestamp AT TIME ZONE :tz AT TIME ZONE 'UTC')
        AND (((:toDate)::timestamp + INTERVAL '1 day' - INTERVAL '1 microsecond') AT TIME ZONE :tz AT TIME ZONE 'UTC')
GROUP BY (recorded_at AT TIME ZONE 'UTC' AT TIME ZONE :tz)::date
ORDER BY (recorded_at AT TIME ZONE 'UTC' AT TIME ZONE :tz)::date;
>>
