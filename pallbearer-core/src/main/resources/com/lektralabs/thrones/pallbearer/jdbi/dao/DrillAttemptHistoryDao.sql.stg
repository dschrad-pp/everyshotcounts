group DrillAttemptHistoryDao;

insertHistory() ::=
<<
INSERT INTO t_drill_attempt_history (
    id,
    user_id,
    drill_id,
    attempts_detected,
    attempts_reported,
    makes_detected,
    makes_reported,
    recorded_at,
    started_at,
    version,
    media_id,
    attempt_local_id,
    attempt_number,
    hot_streak,
    cold_streak
) VALUES (
    :id,
    :userId,
    :drillId,
    :attemptsDetected,
    :attemptsReported,
    :makesDetected,
    :makesReported,
    COALESCE(:recordedAt, NOW()),
    :startedAt,
    :version,
    :mediaId,
    :attemptLocalId,
    :attemptNumber,
    :hotStreak,
    :coldStreak
)
ON CONFLICT (attempt_local_id) DO NOTHING;
>>

updateMediaId() ::=
<<
UPDATE t_drill_attempt_history
   SET media_id = :mediaId
 WHERE drill_id = :drillId
   AND version = :version
>>

updateLatestAttemptMediaId() ::=
<<
UPDATE t_drill_attempt_history
   SET media_id = :mediaId
 WHERE drill_id = :drillId
   AND attempt_number = (SELECT MAX(attempt_number) FROM t_drill_attempt_history WHERE drill_id = :drillId)
>>

findByDrillId() ::=
<<
SELECT *
FROM t_drill_attempt_history
WHERE drill_id = :drillId
ORDER BY recorded_at DESC;
>>

findByUserId() ::=
<<
SELECT *
FROM t_drill_attempt_history
WHERE user_id = :userId
ORDER BY recorded_at DESC;
>>

findByDrillIdAndUserId() ::=
<<
SELECT *
FROM t_drill_attempt_history
WHERE drill_id = :drillId
  AND user_id = :userId
ORDER BY recorded_at DESC;
>>

getAttemptCount() ::=
<<
SELECT COUNT(*)
FROM t_drill_attempt_history
WHERE user_id = :userId
  AND drill_id = :drillId;
>>
