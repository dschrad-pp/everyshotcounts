group MediaImportDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

select() ::= <<
     SELECT id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_media_import
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_media_import
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_media_import (
            id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :name
          , :description
          , :contentUrl
          , :statusCode
          , :mimeType
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_media_import
        SET name = :name
          , description = :description
          , content_url = :contentUrl
          , status_code = :statusCode
          , mime_type = :mimeType
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_media_import WHERE id = :id
>>

deleteAll() ::= <<
      DELETE FROM t_media_import
>>

findByContentUrl() ::= <<
     SELECT id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_media_import
      WHERE content_url = :contentUrl
      LIMIT 1
>>

deleteAllFromProduction() ::= <<
      DELETE FROM t_media
>>

migrateToProduction() ::= <<
      INSERT INTO t_media (
            id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
      )
      SELECT id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_media_import
>>

findAllWithGoogleDriveUrls() ::= <<
     SELECT id
          , name
          , description
          , content_url
          , status_code
          , mime_type
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_media_import
      WHERE content_url IS NOT NULL
        AND content_url LIKE 'https://drive.google.com%'
>>

updateContentUrl() ::= <<
     UPDATE t_media_import
        SET content_url = :contentUrl
          , modification_date = :modificationDate
      WHERE id = :id
>>

updateContentUrlPathPrefix() ::= <<
     UPDATE t_media_import
        SET content_url = REPLACE(content_url, :oldPathPrefix, :newPathPrefix)
          , modification_date = :modificationDate
      WHERE content_url LIKE :oldPathPrefix || '%'
>>
