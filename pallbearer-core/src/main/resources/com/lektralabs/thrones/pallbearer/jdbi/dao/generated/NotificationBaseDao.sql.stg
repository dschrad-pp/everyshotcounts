group NotificationBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , name
          , description
          , sent_user_id
          , recd_user_id
          , notification_type
          , status_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_notification
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_notification
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_notification (
            id
          , name
          , description
          , sent_user_id
          , recd_user_id
          , notification_type
          , status_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :name
          , :description
          , :sentUserId
          , :recdUserId
          , :notificationType
          , :statusCode
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_notification
        SET name = :name
          , description = :description
          , sent_user_id = :sentUserId
          , recd_user_id = :recdUserId
          , notification_type = :notificationType
          , status_code = :statusCode
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_notification WHERE id = :id
>>
