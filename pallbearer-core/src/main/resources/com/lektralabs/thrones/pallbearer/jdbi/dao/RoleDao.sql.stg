group RoleDao;

select() ::= <<
     SELECT id
          , name
          , description
          , status_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_role
      WHERE id = :id
>>

insert() ::= <<
     INSERT INTO t_role (
            id
          , name
          , description
          , status_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :name
          , :description
          , :statusCode
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_role
        SET name = :name
          , description = :description
          , status_code = :statusCode
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_role WHERE id = :id
>>
