group CoachNotificationDao;

insert() ::= <<
    INSERT INTO t_coach_notification (
        id, coach_id, athlete_id, drill_id, drill_item_id, attempt_local_id,
        drill_name, athlete_first_name, athlete_last_name,
        completed_at, is_read, is_dismissed, creation_date,
        score_adjusted, makes_detected, attempts_detected,
        makes_reported, attempts_reported
    ) VALUES (
        :id, :coachId, :athleteId, :drillId, :drillItemId, :attemptLocalId,
        :drillName, :athleteFirstName, :athleteLastName,
        :completedAt, :isRead, :isDismissed, :creationDate,
        :scoreAdjusted, :makesDetected, :attemptsDetected,
        :makesReported, :attemptsReported
    )
>>

findById() ::= <<
    SELECT id
         , coach_id
         , athlete_id
         , drill_id
         , drill_item_id
         , attempt_local_id
         , drill_name
         , athlete_first_name
         , athlete_last_name
         , completed_at
         , is_read
         , is_dismissed
         , creation_date
         , score_adjusted
         , makes_detected
         , attempts_detected
         , makes_reported
         , attempts_reported
      FROM t_coach_notification
     WHERE id = :id
>>

findByCoachIdPaginated() ::= <<
    SELECT id
         , coach_id
         , athlete_id
         , drill_id
         , drill_item_id
         , attempt_local_id
         , drill_name
         , athlete_first_name
         , athlete_last_name
         , completed_at
         , is_read
         , is_dismissed
         , creation_date
         , score_adjusted
         , makes_detected
         , attempts_detected
         , makes_reported
         , attempts_reported
      FROM t_coach_notification
     WHERE coach_id = :coachId
       AND is_dismissed = false
     ORDER BY completed_at DESC
     LIMIT :limit OFFSET :offset
>>

countByCoachId() ::= <<
    SELECT COUNT(*)
      FROM t_coach_notification
     WHERE coach_id = :coachId
       AND is_dismissed = false
>>

countUnreadByCoachId() ::= <<
    SELECT COUNT(*)
      FROM t_coach_notification
     WHERE coach_id = :coachId
       AND is_dismissed = false
       AND is_read = false
>>

markAsRead() ::= <<
    UPDATE t_coach_notification
       SET is_read = true
     WHERE id = :id
       AND coach_id = :callerId
>>

dismiss() ::= <<
    UPDATE t_coach_notification
       SET is_dismissed = true
     WHERE id = :id
       AND coach_id = :callerId
>>

dismissAllByCoachId() ::= <<
    UPDATE t_coach_notification
       SET is_dismissed = true
     WHERE coach_id = :coachId
>>
