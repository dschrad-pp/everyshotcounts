group DrillItemDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

updateMediaId() ::= <<
     UPDATE t_drill_item
        SET media_id = :mediaId
      WHERE id = :drillItemId
>>

getByDrillItemId() ::= <<
    SELECT 
  di.id,
  di.description,
  di.media_thumbnail AS "mediaThumbnail",  <!-- Remove "di." prefix -->
  ...
FROM t_drill_item di
WHERE di.id = :drillItemId
>>



findMaxItemOrder() ::= <<
    SELECT MAX(di.drill_item_order)
      FROM t_drill_item di
     WHERE di.drill_group_id = :drillGroupId
       AND di.level_index = :drillLevelIndex
>>

findAll() ::= <<
    SELECT
        di.id                            AS "id",
        di.drill_group_id                AS "drillGroupId",
        di.name                          AS "name",
        di.description                   AS "description",
        di.media_id                      AS "mediaId",
        di.order_index                   AS "orderIndex",
        di.level_index                   AS "levelIndex",
        di.drill_item_order              AS "drillItemOrder",
        di.passing_score                 AS "passingScore",
        di.visibility_code              AS "visibilityCode",
        di.allow_retry_code              AS "allowRetryCode",
        di.retry_max                     AS "retryMax",
        di.time_limit_ms                 AS "timeLimitMs",
        di.creation_date                 AS "creationDate",
        di.modification_date             AS "modificationDate",
        di.created_by_id                 AS "createdById",
        di.modified_by_id                AS "modifiedById",
        di.version                       AS "version",
        di.level_test                    AS "levelTest",
        di.team_id                       AS "teamId",
        di.shots_max                     AS "shotsMax",
        di.media_thumbnail               AS "mediaThumbnail",
        di.unique_id                     AS "uniqueId",
        -- Corrected: Get mediaStatus from t_media table
        tm.status_code                   AS "mediaStatus",
        -- Select DrillGroupRow fields with appropriate aliases
        dg.id                            AS "drillGroup_id",
        dg.team_id                       AS "drillGroup_teamId",
        dg.name                          AS "drillGroup_name",
        dg.description                   AS "drillGroup_description",
        dg.drill_group_order             AS "drillGroup_drillGroupOrder",
        dg.drill_group_type_code         AS "drillGroup_drillGroupTypeCode",
        dg.creation_date                 AS "drillGroup_creationDate",
        dg.modification_date             AS "drillGroup_modificationDate",
        dg.created_by_id                 AS "drillGroup_createdById",
        dg.modified_by_id                AS "drillGroup_modifiedById",
        dg.version                       AS "drillGroup_version"
    FROM
        t_drill_item di
    JOIN
        t_drill_group dg ON dg.id = di.drill_group_id
    LEFT JOIN -- Use LEFT JOIN because media_id can be null in t_drill_item
        t_media tm ON tm.id = di.media_id
    ORDER BY
        CASE dg.name
            WHEN 'Beginner' THEN 1
            WHEN 'Intermediate' THEN 2
            WHEN 'Advanced' THEN 3
            WHEN 'Elite' THEN 4
            ELSE 99
        END,
        di.order_index ASC,
        di.level_index ASC,
        di.drill_item_order ASC;
>>

findByDrillGroupId() ::= <<
    SELECT
        di.id                            AS "id",
        di.drill_group_id                AS "drillGroupId",
        di.name                          AS "name",
        di.description                   AS "description",
        di.level_index                   AS "levelIndex",
        di.passing_score                 AS "passingScore",
        di.version                       AS "version"
    FROM
        t_drill_item di
    WHERE
        di.drill_group_id = :drillGroupId
>>

updatePassingScore() ::= <<
    UPDATE t_drill_item
       SET passing_score = :passingScore
         , modification_date = :modificationDate
         , modified_by_id = :modifiedById
         , version = version + 1
     WHERE id = :drillItemId
>>

findAllWithGoogleDriveThumbnails() ::= <<
    SELECT
        di.id                            AS "id",
        di.media_thumbnail               AS "mediaThumbnail"
    FROM
        t_drill_item di
    WHERE
        di.media_thumbnail IS NOT NULL
        AND LENGTH(TRIM(di.media_thumbnail)) > 0
        AND di.media_thumbnail LIKE '%drive.google.com%'
        AND di.media_thumbnail NOT LIKE '/%'  -- Exclude local paths
>>

updateMediaThumbnail() ::= <<
    UPDATE t_drill_item
       SET media_thumbnail = :mediaThumbnail
         , modification_date = :modificationDate
         , version = version + 1
     WHERE id = :drillItemId
>>

findAllWithGroupNames() ::= <<
     SELECT di.id
          , di.drill_group_id
          , di.name
          , di.description
          , di.media_id::text AS "mediaId"
          , di.media_thumbnail
          , di.level_index
          , di.drill_item_order
          , di.order_index
          , di.passing_score
          , di.visibility_code
          , di.allow_retry_code
          , di.retry_max
          , di.time_limit_ms
          , di.creation_date
          , di.modification_date
          , di.created_by_id
          , di.modified_by_id
          , di.version
          , di.level_test
          , di.team_id
          , di.shots_max
          , di.unique_id
          , dg.name AS drill_group_name
       FROM t_drill_item di
       JOIN t_drill_group dg ON dg.id = di.drill_group_id
>>

findByMediaId() ::= <<
     SELECT di.id
          , di.drill_group_id
          , di.name
          , di.description
          , di.media_id::text AS "mediaId"
          , di.media_thumbnail
          , di.level_index
          , di.drill_item_order
          , di.order_index
          , di.passing_score
          , di.visibility_code
          , di.allow_retry_code
          , di.retry_max
          , di.time_limit_ms
          , di.creation_date
          , di.modification_date
          , di.created_by_id
          , di.modified_by_id
          , di.version
          , di.level_test
          , di.team_id
          , di.shots_max
          , di.unique_id
          , dg.name AS drill_group_name
       FROM t_drill_item di
       JOIN t_drill_group dg ON dg.id = di.drill_group_id
      WHERE di.media_id = :mediaId
>>

findByUniqueId() ::= <<
     SELECT di.id
          , di.drill_group_id
          , di.name
          , di.description
          , di.media_id::text AS "mediaId"
          , di.media_thumbnail
          , di.level_index
          , di.drill_item_order
          , di.order_index
          , di.passing_score
          , di.visibility_code
          , di.allow_retry_code
          , di.retry_max
          , di.time_limit_ms
          , di.creation_date
          , di.modification_date
          , di.created_by_id
          , di.modified_by_id
          , di.version
          , di.level_test
          , di.team_id
          , di.shots_max
          , di.unique_id
          , dg.name AS drill_group_name
       FROM t_drill_item di
       JOIN t_drill_group dg ON dg.id = di.drill_group_id
      WHERE LOWER(TRIM(di.unique_id)) = LOWER(TRIM(:uniqueId))
>>