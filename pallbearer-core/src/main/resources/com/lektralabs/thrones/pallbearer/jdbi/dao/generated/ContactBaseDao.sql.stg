group ContactBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , contact_type
          , first_name
          , middle_name
          , last_name
          , email
          , telephone
          , birth_date
          , verification_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_contact
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_contact
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_contact (
            id
          , contact_type
          , first_name
          , middle_name
          , last_name
          , email
          , telephone
          , birth_date
          , verification_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :contactType
          , :firstName
          , :middleName
          , :lastName
          , :email
          , :telephone
          , :birthDate
          , :verificationCode
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_contact
        SET contact_type = :contactType
          , first_name = :firstName
          , middle_name = :middleName
          , last_name = :lastName
          , email = :email
          , telephone = :telephone
          , birth_date = :birthDate
          , verification_code = :verificationCode
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_contact WHERE id = :id
>>
