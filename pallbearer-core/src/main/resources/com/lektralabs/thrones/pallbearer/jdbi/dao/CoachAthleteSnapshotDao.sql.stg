group CoachAthleteSnapshotDao;

getAthleteStats(athleteId) ::= <<
WITH streaks AS MATERIALIZED (
    SELECT
        COALESCE(MAX(dah.hot_streak), 0)  AS best_make_streak,
        COALESCE(MAX(dah.cold_streak), 0) AS worst_miss_streak
    FROM t_drill_attempt_history dah
    JOIN t_drill d2 ON d2.id = dah.drill_id
    WHERE d2.user_id = :athleteId
),
ranked AS MATERIALIZED (
    SELECT
        dr.drill_item_id,
        ROW_NUMBER() OVER (
            PARTITION BY dr.drill_item_id
            ORDER BY dr.creation_date
        )                                       AS session_num,
        dr.makes_reported >= di.passing_score   AS is_pass
    FROM t_drill dr
    JOIN t_drill_item di ON di.id = dr.drill_item_id
    WHERE dr.user_id = :athleteId
),
first_pass AS (
    SELECT drill_item_id, MIN(session_num) AS sessions_to_pass
    FROM ranked
    WHERE is_pass = TRUE
    GROUP BY drill_item_id
),
rounds AS MATERIALIZED (
    SELECT COALESCE(ROUND(AVG(sessions_to_pass))::INTEGER, 0) AS rounds_to_pass
    FROM first_pass
)
SELECT
    COALESCE(SUM(d.makes_reported), 0)                                      AS "totalMakes",
    COALESCE(SUM(d.attempts_reported), 0)                                   AS "totalAttempts",
    COUNT(CASE WHEN d.attempts_reported > 0 THEN d.id END)                  AS "sessionCount",
    COALESCE(MAX(d.makes_reported), 0)                                      AS "bestSessionMakes",
    COALESCE(MAX(GREATEST(d.attempts_reported - d.makes_reported, 0)), 0)   AS "worstSessionMisses",
    COALESCE(MAX(s.best_make_streak), 0)                                    AS "bestMakeStreak",
    COALESCE(MAX(s.worst_miss_streak), 0)                                   AS "worstMissStreak",
    COALESCE(MAX(r.rounds_to_pass), 0)                                      AS "roundsToPass"
FROM t_drill d
CROSS JOIN streaks s
CROSS JOIN rounds r
WHERE d.user_id = :athleteId
>>

getSkillBreakdown(athleteId) ::= <<
WITH tag_map (db_code, skill_code) AS (
    VALUES
        ('PULL_UP_L',       'PULL_UP'),
        ('PULL_UP_R',       'PULL_UP'),
        ('STEP_BACK_L',     'STEP_BACK'),
        ('STEP_BACK_R',     'STEP_BACK'),
        ('3PT',             'THREE_POINT'),
        ('15FT',            'SHOOTING'),
        ('DEPTH_SHOOTING',  'SHOOTING'),
        ('CATCH_AND_SHOOT', 'CATCH_SHOOT')
),
total_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT dit.drill_item_id) AS total_drills
    FROM t_drill_item_tag dit
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    GROUP BY tm.skill_code
),
attempted_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT d.drill_item_id) AS drills_attempted
    FROM t_drill d
    JOIN t_drill_item di ON di.id = d.drill_item_id
    JOIN t_drill_item_tag dit ON dit.drill_item_id = di.id
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    WHERE d.user_id = :athleteId
      AND (d.attempts_reported > 0 OR d.attempts_detected > 0)
    GROUP BY tm.skill_code
)
SELECT
    tp.skill_code                                                                        AS "tagCode",
    COALESCE(ROUND((ap.drills_attempted::FLOAT / NULLIF(tp.total_drills, 0)) * 100)::INTEGER, 0)   AS "coveragePercent"
FROM total_per_skill tp
LEFT JOIN attempted_per_skill ap ON ap.skill_code = tp.skill_code
WHERE COALESCE(ap.drills_attempted, 0) > 0
>>

getSkillBreakdownByDifficulty(athleteId, difficultyGroupId) ::= <<
<! Skill breakdown scoped to a single difficulty (drill group). Both the
   numerator (attempted) and denominator (total) pools are restricted to
   drill items whose drill_group_id = :difficultyGroupId. A skill with no
   drills in the group produces no total_per_skill row and is therefore
   omitted; the NULLIF guard remains as defence-in-depth. Because every
   attempted in-group drill is also counted in the in-group total, the
   ratio can never exceed 1 (no >100% values). !>
WITH tag_map (db_code, skill_code) AS (
    VALUES
        ('PULL_UP_L',       'PULL_UP'),
        ('PULL_UP_R',       'PULL_UP'),
        ('STEP_BACK_L',     'STEP_BACK'),
        ('STEP_BACK_R',     'STEP_BACK'),
        ('3PT',             'THREE_POINT'),
        ('15FT',            'SHOOTING'),
        ('DEPTH_SHOOTING',  'SHOOTING'),
        ('CATCH_AND_SHOOT', 'CATCH_SHOOT')
),
total_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT dit.drill_item_id) AS total_drills
    FROM t_drill_item_tag dit
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    JOIN t_drill_item di ON di.id = dit.drill_item_id
    WHERE di.drill_group_id = :difficultyGroupId
    GROUP BY tm.skill_code
),
attempted_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT d.drill_item_id) AS drills_attempted
    FROM t_drill d
    JOIN t_drill_item di ON di.id = d.drill_item_id
    JOIN t_drill_item_tag dit ON dit.drill_item_id = di.id
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    WHERE d.user_id = :athleteId
      AND di.drill_group_id = :difficultyGroupId
      AND (d.attempts_reported > 0 OR d.attempts_detected > 0)
    GROUP BY tm.skill_code
)
SELECT
    tp.skill_code                                                                        AS "tagCode",
    COALESCE(ROUND((ap.drills_attempted::FLOAT / NULLIF(tp.total_drills, 0)) * 100)::INTEGER, 0)   AS "coveragePercent"
FROM total_per_skill tp
LEFT JOIN attempted_per_skill ap ON ap.skill_code = tp.skill_code
WHERE COALESCE(ap.drills_attempted, 0) > 0
>>

getLowestDrillGroupId() ::= <<
<! Deterministic fallback used when an athlete has no active drill group
   set (USER_DRILL_GROUP_KEY missing/invalid): the lowest-order group
   (Beginner). id is a stable tiebreaker. Never falls back to a
   whole-catalog calculation. !>
SELECT id
  FROM t_drill_group
 ORDER BY drill_group_order ASC NULLS LAST, id ASC
 LIMIT 1
>>

getDrillStats(athleteId, limit, offset) ::= <<
SELECT
    di.id                                                                        AS "drillItemId",
    di.name                                                                      AS "drillName",
    COALESCE(SUM(d.makes_reported), 0)                                           AS "totalMakes",
    COALESCE(SUM(d.attempts_reported), 0)                                        AS "totalAttempts",
    COUNT(CASE WHEN d.attempts_reported > 0 THEN d.id END)                       AS "sessions",
    COALESCE(MAX(dah.hot_streak), 0)                                             AS "bestMakeStreak",
    COALESCE(MAX(dah.cold_streak), 0)                                            AS "longestMissStreak",
    AVG(
        CASE WHEN dah.started_at IS NOT NULL AND dah.recorded_at IS NOT NULL
             THEN EXTRACT(EPOCH FROM (dah.recorded_at - dah.started_at))
        END
    )                                                                            AS "avgTimePerRoundSeconds"
FROM t_drill d
JOIN t_drill_item di ON di.id = d.drill_item_id
LEFT JOIN t_drill_attempt_history dah ON dah.drill_id = d.id
WHERE d.user_id = :athleteId
GROUP BY di.id, di.name
ORDER BY COUNT(d.id) DESC,
         (COALESCE(SUM(d.makes_reported), 0) * 1.0 / NULLIF(SUM(d.attempts_reported), 0)) DESC NULLS LAST
LIMIT :limit OFFSET :offset
>>

getDrillStatsWithTagFilter(athleteId, tagCodes, limit, offset) ::= <<
SELECT
    di.id                                                                        AS "drillItemId",
    di.name                                                                      AS "drillName",
    COALESCE(SUM(d.makes_reported), 0)                                           AS "totalMakes",
    COALESCE(SUM(d.attempts_reported), 0)                                        AS "totalAttempts",
    COUNT(CASE WHEN d.attempts_reported > 0 THEN d.id END)                       AS "sessions",
    COALESCE(MAX(dah.hot_streak), 0)                                             AS "bestMakeStreak",
    COALESCE(MAX(dah.cold_streak), 0)                                            AS "longestMissStreak",
    AVG(
        CASE WHEN dah.started_at IS NOT NULL AND dah.recorded_at IS NOT NULL
             THEN EXTRACT(EPOCH FROM (dah.recorded_at - dah.started_at))
        END
    )                                                                            AS "avgTimePerRoundSeconds"
FROM t_drill d
JOIN t_drill_item di ON di.id = d.drill_item_id
LEFT JOIN t_drill_attempt_history dah ON dah.drill_id = d.id
WHERE d.user_id = :athleteId
  AND di.id IN (
      SELECT dit.drill_item_id
        FROM t_drill_item_tag dit
        JOIN t_tag t ON t.id = dit.tag_id
       WHERE t.code IN (:tagCodes)
  )
GROUP BY di.id, di.name
ORDER BY COUNT(d.id) DESC,
         (COALESCE(SUM(d.makes_reported), 0) * 1.0 / NULLIF(SUM(d.attempts_reported), 0)) DESC NULLS LAST
LIMIT :limit OFFSET :offset
>>

getSkillTagsForDrillItems(drillItemIds) ::= <<
SELECT DISTINCT
    dit.drill_item_id   AS "drillItemId",
    CASE t.code
        WHEN 'PULL_UP_L'        THEN 'PULL_UP'
        WHEN 'PULL_UP_R'        THEN 'PULL_UP'
        WHEN 'STEP_BACK_L'      THEN 'STEP_BACK'
        WHEN 'STEP_BACK_R'      THEN 'STEP_BACK'
        WHEN '3PT'              THEN 'THREE_POINT'
        WHEN '15FT'             THEN 'SHOOTING'
        WHEN 'DEPTH_SHOOTING'   THEN 'SHOOTING'
        WHEN 'CATCH_AND_SHOOT'  THEN 'CATCH_SHOOT'
    END                 AS "tagCode",
    CASE t.code
        WHEN 'PULL_UP_L'        THEN 'Pull-Up'
        WHEN 'PULL_UP_R'        THEN 'Pull-Up'
        WHEN 'STEP_BACK_L'      THEN 'Step-Back'
        WHEN 'STEP_BACK_R'      THEN 'Step-Back'
        WHEN '3PT'              THEN '3-Point'
        WHEN '15FT'             THEN 'Shooting'
        WHEN 'DEPTH_SHOOTING'   THEN 'Shooting'
        WHEN 'CATCH_AND_SHOOT'  THEN 'Catch & Shoot'
    END                 AS "tagName"
FROM t_drill_item_tag dit
JOIN t_tag t ON t.id = dit.tag_id
WHERE dit.drill_item_id IN (:drillItemIds)
  AND t.code IN ('PULL_UP_L','PULL_UP_R','STEP_BACK_L','STEP_BACK_R',
                 '3PT','15FT','DEPTH_SHOOTING','CATCH_AND_SHOOT')
ORDER BY "tagCode"
>>
