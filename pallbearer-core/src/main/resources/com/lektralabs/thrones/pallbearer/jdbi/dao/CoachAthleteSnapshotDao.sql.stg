group CoachAthleteSnapshotDao;

getAthleteStats(athleteId, difficultyGroupId) ::= <<
<! Headline make/attempt totals for one athlete, scoped to the active difficulty
   (drill group) — the SAME scoping the shooting zones and skill breakdown use, so
   the headline spans the tier the athlete is currently on rather than mixing every
   tier together. (Previously this query had no drill_group_id filter; the bug was
   invisible only for athletes whose data lives entirely in one tier.)

   Totals/best/worst are summed per ROUND from t_drill_attempt_history (one row per
   round), not from t_drill (whose makes_reported/attempts_reported are overwritten
   to the latest round on every submission). The effective_rounds CTE emits one row
   per round via a LEFT JOIN, falling back to the t_drill summary row for any drill
   with no history (defence-in-depth; current prod has none). bestSessionMakes /
   worstSessionMisses are per-round MAX, matching the "best/worst session" intent
   rather than the overwritten latest value; sessionCount counts rounds with shots
   so it stays consistent with that per-round unit. streaks and roundsToPass keep
   their existing per-t_drill "did the latest attempt pass" semantics, unchanged. !>
WITH streaks AS MATERIALIZED (
    SELECT
        COALESCE(MAX(dah.hot_streak), 0)  AS best_make_streak,
        COALESCE(MAX(dah.cold_streak), 0) AS worst_miss_streak
    FROM t_drill_attempt_history dah
    JOIN t_drill d2 ON d2.id = dah.drill_id
    WHERE d2.user_id = :athleteId
),
ranked AS MATERIALIZED (
    SELECT
        dr.drill_item_id,
        ROW_NUMBER() OVER (
            PARTITION BY dr.drill_item_id
            ORDER BY dr.creation_date
        )                                       AS session_num,
        dr.makes_reported >= di.passing_score   AS is_pass
    FROM t_drill dr
    JOIN t_drill_item di ON di.id = dr.drill_item_id
    WHERE dr.user_id = :athleteId
),
first_pass AS (
    SELECT drill_item_id, MIN(session_num) AS sessions_to_pass
    FROM ranked
    WHERE is_pass = TRUE
    GROUP BY drill_item_id
),
rounds AS MATERIALIZED (
    SELECT COALESCE(ROUND(AVG(sessions_to_pass))::INTEGER, 0) AS rounds_to_pass
    FROM first_pass
),
effective_rounds AS (
    SELECT
        COALESCE(h.makes_reported,    d.makes_reported)    AS makes,
        COALESCE(h.attempts_reported, d.attempts_reported) AS attempts
    FROM t_drill d
    JOIN t_drill_item di ON di.id = d.drill_item_id
    LEFT JOIN t_drill_attempt_history h ON h.drill_id = d.id
    WHERE d.user_id = :athleteId
      AND di.drill_group_id = :difficultyGroupId
)
SELECT
    COALESCE(SUM(er.makes), 0)                                              AS "totalMakes",
    COALESCE(SUM(er.attempts), 0)                                           AS "totalAttempts",
    COUNT(CASE WHEN er.attempts > 0 THEN 1 END)                            AS "sessionCount",
    COALESCE(MAX(er.makes), 0)                                              AS "bestSessionMakes",
    COALESCE(MAX(GREATEST(er.attempts - er.makes, 0)), 0)                   AS "worstSessionMisses",
    COALESCE(MAX(s.best_make_streak), 0)                                    AS "bestMakeStreak",
    COALESCE(MAX(s.worst_miss_streak), 0)                                   AS "worstMissStreak",
    COALESCE(MAX(r.rounds_to_pass), 0)                                      AS "roundsToPass"
FROM effective_rounds er
CROSS JOIN streaks s
CROSS JOIN rounds r
>>

getTeamStatsByCoachId(coachId, drillGroupKey, orderIndexKey) ::= <<
<! Whole-roster make/attempt totals in ONE query — the batch replacement for the
   per-athlete snapshot fan-out the coach Team tab used (N+1). Semantics match
   getAthleteStats exactly: per-athlete totals are scoped to that athlete's ACTIVE
   difficulty (drill group), and shots are summed per ROUND from
   t_drill_attempt_history with a COALESCE fallback to the t_drill summary row for
   drills with no history (see getAthleteStats note).

   roster: same membership joins as CoachDao.selectAllAthletesAssignedToCoach —
   athletes sharing a team with the coach — so this endpoint can never disagree
   with the roster endpoint about who is on the team. Athletes with no drills
   still emit a row (LEFT JOIN) with zeroed totals.

   active_group: SQL mirror of resolveActiveDifficultyGroupId — the athlete's
   user.drill.group property when it holds a valid UUID, else the lowest-order
   drill group. The regex guard replicates the Java try/catch on UUID.fromString.

   levelOrderIndex: the active group's user.drill.group.order.index, float-formatted
   in the DB ("2.0"), truncated like the Java (int) Double.parseDouble; 0 when the
   property is missing/unparseable, matching the roster payload's client fallback. !>
WITH roster AS (
    SELECT DISTINCT au.id AS user_id
    FROM t_user au
    JOIN t_user_role_xref aur ON au.id = aur.user_id
    JOIN t_role ar          ON aur.role_id = ar.id
    JOIN t_team_user_xref atux ON au.id = atux.user_id
    JOIN t_team_user_xref ctux ON atux.team_id = ctux.team_id
    JOIN t_user_role_xref cur ON ctux.user_id = cur.user_id
    JOIN t_role cr          ON cur.role_id = cr.id
    WHERE ar.name = 'ATHLETE'
      AND cr.name = 'COACH'
      AND ctux.user_id = :coachId
),
lowest_group AS (
    SELECT id
      FROM t_drill_group
     ORDER BY drill_group_order ASC NULLS LAST, id ASC
     LIMIT 1
),
active_group AS (
    SELECT r.user_id,
           COALESCE(
               (SELECT up.property_value::uuid
                  FROM t_user_property up
                 WHERE up.user_id = r.user_id
                   AND up.property_key = :drillGroupKey
                   AND up.property_value ~* '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
                 LIMIT 1),
               (SELECT id FROM lowest_group)
           ) AS group_id
    FROM roster r
),
per_round AS (
    SELECT d.user_id,
           COALESCE(h.makes_reported,    d.makes_reported)    AS makes,
           COALESCE(h.attempts_reported, d.attempts_reported) AS attempts
    FROM t_drill d
    JOIN t_drill_item di ON di.id = d.drill_item_id
    JOIN active_group ag ON ag.user_id = d.user_id
                        AND di.drill_group_id = ag.group_id
    LEFT JOIN t_drill_attempt_history h ON h.drill_id = d.id
)
SELECT
    ag.user_id                                                  AS "userId",
    COALESCE(SUM(pr.makes), 0)::INTEGER                         AS "totalMakes",
    COALESCE(SUM(pr.attempts), 0)::INTEGER                      AS "totalAttempts",
    COUNT(CASE WHEN pr.attempts > 0 THEN 1 END)::INTEGER        AS "sessionCount",
    COALESCE((
        SELECT TRUNC(ugp.property_value::NUMERIC)::INTEGER
          FROM t_user_drill_group_property ugp
         WHERE ugp.user_id = ag.user_id
           AND ugp.drill_group_id = ag.group_id
           AND ugp.property_key = :orderIndexKey
           AND ugp.property_value ~ '^[0-9]+([.][0-9]+)?$'
         LIMIT 1
    ), 0)                                                       AS "levelOrderIndex"
FROM active_group ag
LEFT JOIN per_round pr ON pr.user_id = ag.user_id
GROUP BY ag.user_id
>>

getSkillBreakdown(athleteId) ::= <<
WITH tag_map (db_code, skill_code) AS (
    VALUES
        ('PULL_UP_L',       'PULL_UP'),
        ('PULL_UP_R',       'PULL_UP'),
        ('STEP_BACK_L',     'STEP_BACK'),
        ('STEP_BACK_R',     'STEP_BACK'),
        ('3PT',             'THREE_POINT'),
        ('15FT',            'SHOOTING'),
        ('DEPTH_SHOOTING',  'SHOOTING'),
        ('CATCH_AND_SHOOT', 'CATCH_SHOOT')
),
total_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT dit.drill_item_id) AS total_drills
    FROM t_drill_item_tag dit
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    GROUP BY tm.skill_code
),
passed_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT d.drill_item_id) AS drills_passed
    FROM t_drill d
    JOIN t_drill_item di ON di.id = d.drill_item_id
    JOIN t_drill_item_tag dit ON dit.drill_item_id = di.id
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    WHERE d.user_id = :athleteId
      AND d.makes_reported >= di.passing_score
    GROUP BY tm.skill_code
)
SELECT
    tp.skill_code                                                                        AS "tagCode",
    COALESCE(ROUND((ap.drills_passed::FLOAT / NULLIF(tp.total_drills, 0)) * 100)::INTEGER, 0)   AS "coveragePercent"
FROM total_per_skill tp
LEFT JOIN passed_per_skill ap ON ap.skill_code = tp.skill_code
WHERE COALESCE(ap.drills_passed, 0) > 0
>>

getSkillBreakdownByDifficulty(athleteId, difficultyGroupId) ::= <<
<! Skill breakdown scoped to a single difficulty (drill group). Both the
   numerator (passed) and denominator (total) pools are restricted to
   drill items whose drill_group_id = :difficultyGroupId. "Passed" uses the
   same predicate as roundsToPass (makes_reported >= passing_score). A skill
   with no drills in the group produces no total_per_skill row and is
   therefore omitted; the NULLIF guard remains as defence-in-depth. Because
   every passed in-group drill is also counted in the in-group total, the
   ratio can never exceed 1 (no >100% values). !>
WITH tag_map (db_code, skill_code) AS (
    VALUES
        ('PULL_UP_L',       'PULL_UP'),
        ('PULL_UP_R',       'PULL_UP'),
        ('STEP_BACK_L',     'STEP_BACK'),
        ('STEP_BACK_R',     'STEP_BACK'),
        ('3PT',             'THREE_POINT'),
        ('15FT',            'SHOOTING'),
        ('DEPTH_SHOOTING',  'SHOOTING'),
        ('CATCH_AND_SHOOT', 'CATCH_SHOOT')
),
total_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT dit.drill_item_id) AS total_drills
    FROM t_drill_item_tag dit
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    JOIN t_drill_item di ON di.id = dit.drill_item_id
    WHERE di.drill_group_id = :difficultyGroupId
    GROUP BY tm.skill_code
),
passed_per_skill AS (
    SELECT tm.skill_code, COUNT(DISTINCT d.drill_item_id) AS drills_passed
    FROM t_drill d
    JOIN t_drill_item di ON di.id = d.drill_item_id
    JOIN t_drill_item_tag dit ON dit.drill_item_id = di.id
    JOIN t_tag t ON t.id = dit.tag_id
    JOIN tag_map tm ON tm.db_code = t.code
    WHERE d.user_id = :athleteId
      AND di.drill_group_id = :difficultyGroupId
      AND d.makes_reported >= di.passing_score
    GROUP BY tm.skill_code
)
SELECT
    tp.skill_code                                                                        AS "tagCode",
    COALESCE(ROUND((ap.drills_passed::FLOAT / NULLIF(tp.total_drills, 0)) * 100)::INTEGER, 0)   AS "coveragePercent"
FROM total_per_skill tp
LEFT JOIN passed_per_skill ap ON ap.skill_code = tp.skill_code
WHERE COALESCE(ap.drills_passed, 0) > 0
>>

getLowestDrillGroupId() ::= <<
<! Deterministic fallback used when an athlete has no active drill group
   set (USER_DRILL_GROUP_KEY missing/invalid): the lowest-order group
   (Beginner). id is a stable tiebreaker. Never falls back to a
   whole-catalog calculation. !>
SELECT id
  FROM t_drill_group
 ORDER BY drill_group_order ASC NULLS LAST, id ASC
 LIMIT 1
>>

getShootingZonesByDifficulty(athleteId, difficultyGroupId) ::= <<
<! Make/attempt totals per court zone for one athlete, scoped to a single
   difficulty (drill group) — the same scoping the skill breakdown uses, so the
   coach sees zone make% for the difficulty the athlete is currently on
   (Beginner / Intermediate / …), not the whole catalogue.

   Source of truth: shot counts are recorded per drill *session* on t_drill
   (makes_reported / attempts_reported), never per individual shot, so a session
   is attributed to a zone through its drill item's shot-type tags. Each zone is
   an independent metric — "of the shots you took at drills tagged for this
   zone, what % went in" — mirroring how skillBreakdown / getDrillStats filter
   by tag membership. A combo drill (e.g. "15 ft → 3-Point") therefore counts
   toward BOTH the 15ft and 3pt zones; this is intentional and does not partition
   the overall make% (which is computed separately).

   Zone tag mapping:
     THREE_POINT  <- 3PT, DEPTH_SHOOTING   (both beyond the arc)
     FIFTEEN_FEET <- 15FT
     FREE_THROW   <- FREE_THROW_ROUTINE
   item_zone is DISTINCT on (drill_item, zone) so a drill item carrying two tags
   that map to the same zone (3PT + DEPTH_SHOOTING) is still counted once per
   zone — no within-zone double-count. Drill items with no zone tag are excluded.
   Only zones with data are returned; three-zone padding and makePercent are
   applied in the service/response layer.

   Round-level totals: shot counts are summed from t_drill_attempt_history (one
   row per round), NOT from t_drill (whose makes_reported/attempts_reported are
   OVERWRITTEN to the most recent round on every submission). Summing t_drill
   collapsed every drill to a single round (e.g. Jasen / Elite / 3-Point read
   43/60 — the last round of each drill — instead of 107/220 across all rounds).
   The LEFT JOIN + COALESCE falls back to the t_drill summary row only for drills
   that have no history rows (defence-in-depth for any pre-history drill; current
   prod has none), so such a drill still contributes its single value instead of
   silently zeroing. !>
WITH zone_map (db_code, zone_code) AS (
    VALUES
        ('3PT',                'THREE_POINT'),
        ('DEPTH_SHOOTING',     'THREE_POINT'),
        ('15FT',               'FIFTEEN_FEET'),
        ('FREE_THROW_ROUTINE', 'FREE_THROW')
),
item_zone AS (
    SELECT DISTINCT dit.drill_item_id, zm.zone_code
    FROM t_drill_item_tag dit
    JOIN t_tag t     ON t.id = dit.tag_id
    JOIN zone_map zm ON zm.db_code = t.code
)
SELECT
    iz.zone_code                                                            AS "zoneCode",
    COALESCE(SUM(COALESCE(h.makes_reported, d.makes_reported)), 0)::INTEGER    AS "totalMakes",
    COALESCE(SUM(COALESCE(h.attempts_reported, d.attempts_reported)), 0)::INTEGER AS "totalAttempts"
FROM t_drill d
JOIN t_drill_item di ON di.id = d.drill_item_id
JOIN item_zone iz    ON iz.drill_item_id = d.drill_item_id
LEFT JOIN t_drill_attempt_history h ON h.drill_id = d.id
WHERE d.user_id = :athleteId
  AND di.drill_group_id = :difficultyGroupId
GROUP BY iz.zone_code
>>

getDrillStats(athleteId, limit, offset) ::= <<
<! Per-drill totals sum makes/attempts per ROUND from t_drill_attempt_history
   (one row per round), not from t_drill (overwritten to the latest round). Because
   dah is already LEFT JOINed for streaks/timing, every t_drill row fans out to its
   rounds, so the old SUM(d.makes_reported) actually MULTIPLIED the latest round by
   the round count; COALESCE(dah.*, d.*) sums the real per-round values and falls
   back to the t_drill summary only for drills with no history. sessions counts
   rounds with shots; streaks/timing already come from dah and are unchanged. !>
SELECT
    di.id                                                                        AS "drillItemId",
    di.name                                                                      AS "drillName",
    COALESCE(SUM(COALESCE(dah.makes_reported, d.makes_reported)), 0)              AS "totalMakes",
    COALESCE(SUM(COALESCE(dah.attempts_reported, d.attempts_reported)), 0)        AS "totalAttempts",
    COUNT(CASE WHEN COALESCE(dah.attempts_reported, d.attempts_reported) > 0 THEN 1 END) AS "sessions",
    COALESCE(MAX(dah.hot_streak), 0)                                             AS "bestMakeStreak",
    COALESCE(MAX(dah.cold_streak), 0)                                            AS "longestMissStreak",
    AVG(
        CASE WHEN dah.started_at IS NOT NULL AND dah.recorded_at IS NOT NULL
             THEN EXTRACT(EPOCH FROM (dah.recorded_at - dah.started_at))
        END
    )                                                                            AS "avgTimePerRoundSeconds"
FROM t_drill d
JOIN t_drill_item di ON di.id = d.drill_item_id
LEFT JOIN t_drill_attempt_history dah ON dah.drill_id = d.id
WHERE d.user_id = :athleteId
GROUP BY di.id, di.name
ORDER BY COUNT(d.id) DESC,
         (COALESCE(SUM(COALESCE(dah.makes_reported, d.makes_reported)), 0) * 1.0
              / NULLIF(SUM(COALESCE(dah.attempts_reported, d.attempts_reported)), 0)) DESC NULLS LAST
LIMIT :limit OFFSET :offset
>>

getDrillStatsWithTagFilter(athleteId, tagCodes, limit, offset) ::= <<
<! Tag-filtered variant of getDrillStats: same per-round summation from
   t_drill_attempt_history (see getDrillStats note); only the drill-item tag
   filter differs. !>
SELECT
    di.id                                                                        AS "drillItemId",
    di.name                                                                      AS "drillName",
    COALESCE(SUM(COALESCE(dah.makes_reported, d.makes_reported)), 0)              AS "totalMakes",
    COALESCE(SUM(COALESCE(dah.attempts_reported, d.attempts_reported)), 0)        AS "totalAttempts",
    COUNT(CASE WHEN COALESCE(dah.attempts_reported, d.attempts_reported) > 0 THEN 1 END) AS "sessions",
    COALESCE(MAX(dah.hot_streak), 0)                                             AS "bestMakeStreak",
    COALESCE(MAX(dah.cold_streak), 0)                                            AS "longestMissStreak",
    AVG(
        CASE WHEN dah.started_at IS NOT NULL AND dah.recorded_at IS NOT NULL
             THEN EXTRACT(EPOCH FROM (dah.recorded_at - dah.started_at))
        END
    )                                                                            AS "avgTimePerRoundSeconds"
FROM t_drill d
JOIN t_drill_item di ON di.id = d.drill_item_id
LEFT JOIN t_drill_attempt_history dah ON dah.drill_id = d.id
WHERE d.user_id = :athleteId
  AND di.id IN (
      SELECT dit.drill_item_id
        FROM t_drill_item_tag dit
        JOIN t_tag t ON t.id = dit.tag_id
       WHERE t.code IN (:tagCodes)
  )
GROUP BY di.id, di.name
ORDER BY COUNT(d.id) DESC,
         (COALESCE(SUM(COALESCE(dah.makes_reported, d.makes_reported)), 0) * 1.0
              / NULLIF(SUM(COALESCE(dah.attempts_reported, d.attempts_reported)), 0)) DESC NULLS LAST
LIMIT :limit OFFSET :offset
>>

getSkillTagsForDrillItems(drillItemIds) ::= <<
SELECT DISTINCT
    dit.drill_item_id   AS "drillItemId",
    CASE t.code
        WHEN 'PULL_UP_L'        THEN 'PULL_UP'
        WHEN 'PULL_UP_R'        THEN 'PULL_UP'
        WHEN 'STEP_BACK_L'      THEN 'STEP_BACK'
        WHEN 'STEP_BACK_R'      THEN 'STEP_BACK'
        WHEN '3PT'              THEN 'THREE_POINT'
        WHEN '15FT'             THEN 'SHOOTING'
        WHEN 'DEPTH_SHOOTING'   THEN 'SHOOTING'
        WHEN 'CATCH_AND_SHOOT'  THEN 'CATCH_SHOOT'
    END                 AS "tagCode",
    CASE t.code
        WHEN 'PULL_UP_L'        THEN 'Pull-Up'
        WHEN 'PULL_UP_R'        THEN 'Pull-Up'
        WHEN 'STEP_BACK_L'      THEN 'Step-Back'
        WHEN 'STEP_BACK_R'      THEN 'Step-Back'
        WHEN '3PT'              THEN '3-Point'
        WHEN '15FT'             THEN 'Shooting'
        WHEN 'DEPTH_SHOOTING'   THEN 'Shooting'
        WHEN 'CATCH_AND_SHOOT'  THEN 'Catch & Shoot'
    END                 AS "tagName"
FROM t_drill_item_tag dit
JOIN t_tag t ON t.id = dit.tag_id
WHERE dit.drill_item_id IN (:drillItemIds)
  AND t.code IN ('PULL_UP_L','PULL_UP_R','STEP_BACK_L','STEP_BACK_R',
                 '3PT','15FT','DEPTH_SHOOTING','CATCH_AND_SHOOT')
ORDER BY "tagCode"
>>
