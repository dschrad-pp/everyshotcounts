group TeamDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

insertJoinCode() ::= <<
    INSERT INTO t_team_join_code (team_id, join_code)
    VALUES (:teamId, :joinCode)
>>

findTeamByJoinCode() ::= <<
    SELECT t.id
         , t.sport_id
         , t.organization_id
         , t.name
         , t.description
      FROM t_team t
      JOIN t_team_join_code jc ON t.id = jc.team_id
     WHERE jc.join_code = :joinCode
>>

findJoinCodeByTeamId() ::= <<
    SELECT join_code
      FROM t_team_join_code
     WHERE team_id = :teamId
>>

userHasTeam() ::= <<
    SELECT EXISTS (
        SELECT 1
          FROM t_team_user_xref
         WHERE user_id = :userId
    )
>>

findTeamByUserId() ::= <<
    SELECT t.id
         , t.sport_id
         , t.organization_id
         , t.name
         , t.description
      FROM t_team t
      JOIN t_team_user_xref xref ON t.id = xref.team_id
     WHERE xref.user_id = :userId
     LIMIT 1
>>

removeUserFromTeam() ::= <<
    DELETE FROM t_team_user_xref
     WHERE team_id = :teamId
       AND user_id = :userId
>>

findCoachNameByTeamId() ::= <<
    SELECT c.first_name || ' ' || c.last_name
      FROM t_contact c
      JOIN t_user u ON u.contact_id = c.id
      JOIN t_user_role_xref ur ON u.id = ur.user_id
      JOIN t_role r ON ur.role_id = r.id
      JOIN t_team_user_xref xref ON u.id = xref.user_id
     WHERE xref.team_id = :teamId
       AND r.name = 'COACH'
     LIMIT 1
>>
