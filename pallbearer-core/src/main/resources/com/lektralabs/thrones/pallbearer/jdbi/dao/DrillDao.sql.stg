group DrillDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

selectByDrillItemIdAndUserId() ::= <<
     SELECT id
          , drill_item_id
          , user_id
          , media_id
          , drill_status
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_drill
      WHERE drill_item_id = :drillItemId
        AND user_id = :userId
>>

updateMediaId() ::= <<
     UPDATE t_drill
        SET media_id = :mediaId
      WHERE id = :drillId
>>

updateAttemptsAndMakesDetected() ::= <<
     UPDATE t_drill
        SET attempts_detected = :attemptsDetected
          , makes_detected = :makesDetected
      WHERE id = :drillId
>>

updateDrillStatus() ::= <<
     UPDATE t_drill
        SET drill_status = :drillStatusCode
      WHERE id = :drillId
>>
