group ChallengeEntryVoteBaseDao;

comment() ::= <<
<! // This is generated code. Do not modify - it will be overwritten. See the non-base version. !>
>>

select() ::= <<
     SELECT id
          , challenge_entry_id
          , vote_type_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
       FROM t_challenge_entry_vote
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_challenge_entry_vote
     <findOptions>
>>

insert() ::= <<
     INSERT INTO t_challenge_entry_vote (
            id
          , challenge_entry_id
          , vote_type_code
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
     ) VALUES (
            :id
          , :challengeEntryId
          , :voteTypeCode
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
     )
>>

update() ::= <<
     UPDATE t_challenge_entry_vote
        SET challenge_entry_id = :challengeEntryId
          , vote_type_code = :voteTypeCode
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_challenge_entry_vote WHERE id = :id
>>
