     , elama.email AS elama_email
     , elama.mobile_phone AS elama_mobile_phone
     , elama.first_name AS elama_first_name
     , elama.last_name AS elama_last_name
     , elama.birth_date AS elama_birth_date
     , elama.registration_status AS elama_registration_status
     , elama.payment_status AS elama_payment_status
     , elama.status_code AS elama_status_code
     , elama.action_code AS elama_action_code
     , elama.creation_date AS elama_creation_date
     , elama.modification_date AS elama_modification_date
     , elama.created_by_id AS elama_created_by_id
     , elama.modified_by_id AS elama_modified_by_id
     , elama.version AS elama_version
     , u.id AS user_id
     , u.email AS user_email
     , u.user_alias AS user_user_alias
     , u.username AS user_username
     , u.contact_id AS user_contact_id
     , u.keycloak_id AS user_keycloak_id
     , u.avatar_byte_array AS user_avatar_byte_array
     , u.avatar_mime_type AS user_avatar_mime_type
     , u.status_code AS user_status_code
     , u.creation_date AS user_creation_date
     , u.modification_date AS user_modification_date
     , u.created_by_id AS user_created_by_id
     , u.modified_by_id AS user_modified_by_id
     , u.version AS user_version
  FROM t_esc_league_apps_member_action elama
