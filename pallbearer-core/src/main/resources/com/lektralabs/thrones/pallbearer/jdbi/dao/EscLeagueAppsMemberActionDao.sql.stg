group EscLeagueAppsMemberActionDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

updateActions() ::= <<
WITH cte_lam AS (
SELECT DISTINCT ON (lam.username)
       COALESCE(elama.id, uuid_generate_v4()) AS id
     , lam.id AS member_id
     , lar.id AS registration_id
     , lam.user_id AS user_id
     , lam.username AS username_la
     , lam.username AS username_esc -- do not update
     , COALESCE(lam.email, lar.email, lar.parent_email) AS email
     , lam.mobile_phone AS mobile_phone
     , lar.first_name AS first_name
     , lar.last_name AS last_name
     , lam.birth_date AS birth_date
     , lar.registration_status AS regsitration_status
     , lar.payment_status AS payment_status
     , 'PENDING' AS status_code
  FROM t_league_apps_member lam
  JOIN t_league_apps_registration lar ON lar.user_id = lam.user_id
  LEFT JOIN t_esc_league_apps_member_action elama ON elama.username_la = lam.username
 WHERE lar.last_updated > :lastUpdated
    OR lam.last_updated > :lastUpdated
)
 INSERT INTO t_esc_league_apps_member_action
 SELECT * FROM cte_lam
     ON CONFLICT (id) DO UPDATE
    SET member_id = excluded.member_id
      , registration_id = excluded.registration_id
      , user_id = excluded.user_id
      , email = excluded.email
      , mobile_phone = excluded.mobile_phone
      , first_name = excluded.first_name
      , last_name  = excluded.last_name
      , birth_date = excluded.birth_date
      , registration_status  = excluded.registration_status
      , payment_status  = excluded.payment_status
      , status_code  = excluded.status_code
>>

getActionItems() ::= <<
SELECT elama.id AS elama_id
     , elama.member_id AS elama_member_id
     , elama.registration_id AS elama_registration_id
     , elama.user_id AS elama_user_id
     , elama.username_la AS elama_username_la
     , elama.username_esc AS elama_username_esc
     , elama.email AS elama_email
     , elama.mobile_phone AS elama_mobile_phone
     , elama.first_name AS elama_first_name
     , elama.last_name AS elama_last_name
     , elama.birth_date AS elama_birth_date
     , elama.registration_status AS elama_registration_status
     , elama.payment_status AS elama_payment_status
     , elama.status_code AS elama_status_code
     , elama.action_code AS elama_action_code
     , elama.creation_date AS elama_creation_date
     , elama.modification_date AS elama_modification_date
     , elama.created_by_id AS elama_created_by_id
     , elama.modified_by_id AS elama_modified_by_id
     , elama.version AS elama_version
     , u.id AS user_id
     , u.email AS user_email
     , u.user_alias AS user_user_alias
     , u.username AS user_username
     , u.contact_id AS user_contact_id
     , u.keycloak_id AS user_keycloak_id
     , u.avatar_byte_array AS user_avatar_byte_array
     , u.avatar_mime_type AS user_avatar_mime_type
     , u.status_code AS user_status_code
     , u.creation_date AS user_creation_date
     , u.modification_date AS user_modification_date
     , u.created_by_id AS user_created_by_id
     , u.modified_by_id AS user_modified_by_id
     , u.version AS user_version
  FROM t_esc_league_apps_member_action elama
  LEFT JOIN t_user u ON u.username = elama.username_esc
 WHERE elama.status_code = 'PENDING'
>>

getAllActionItems() ::= <<
SELECT elama.id AS elama_id
     , elama.member_id AS elama_member_id
     , elama.registration_id AS elama_registration_id
     , elama.user_id AS elama_user_id
     , elama.username_la AS elama_username_la
