       , di.visibility_code          AS "di_visibilityCode"
       , di.allow_retry_code         AS "di_allowRetryCode"
       , di.order_index              AS "di_orderIndex"
       , di.retry_max                AS "di_retryMax"
       , di.time_limit_ms            AS "di_timeLimitMs"
       , dg.id                       AS "dg_id"
       , dg.team_id                  AS "dg_teamId"
       , dg.name                     AS "dg_name"
       , dg.description              AS "dg_description"
       , dg.drill_group_order        AS "dg_drillGroupOrder"
       , dg.drill_group_type_code    AS "dg_drillGroupTypeCode"
       , dg.creation_date            AS "dg_creationDate"
       , dg.modification_date        AS "dg_modificationDate"
       , dg.created_by_id            AS "dg_createdById"
       , dg.modified_by_id           AS "dg_modifiedById"
       , dg.version                  AS "dg_version"
       , dr.id                       AS "dr_id"
       , dr.drill_item_id            AS "dr_drillItemId"
       , dr.user_id                  AS "dr_userId"
       , dr.media_id                 AS "dr_mediaId"
       , m.status_code               AS "dr_mediaStatus"
       , dr.drill_status             AS "dr_drillStatus"
       , dr.attempts_detected        AS "dr_attemptsDetected"
       , dr.attempts_reported        AS "dr_attemptsReported"
       , dr.makes_detected           AS "dr_makesDetected"
       , dr.makes_reported           AS "dr_makesReported"
       , dr.creation_date            AS "dr_creationDate"
       , dr.modification_date        AS "dr_modificationDate"
       , dr.created_by_id            AS "dr_createdById"
       , dr.modified_by_id           AS "dr_modifiedById"
       , dr.version                  AS "dr_version"
       , cu.id                       AS "cu_userId"
       , cu.email                    AS "cu_email"
       , cu.user_alias               AS "cu_userAlias"
       , cu.username                 AS "cu_username"
       , cc.id                       AS "cc_id"
       , cc.contact_type             AS "cc_contactType"
       , cc.first_name               AS "cc_firstName"
       , cc.last_name                AS "cc_lastName"
       , cc.email                    AS "cc_email"
       , cc.birth_date               AS "cc_birthDate"
       , cc.version                  AS "cc_version"
       , mu.id                       AS "mu_userId"
       , mu.email                    AS "mu_email"
       , mu.user_alias               AS "mu_userAlias"
       , mu.username                 AS "mu_username"
       , mc.id                       AS "mc_id"
       , mc.contact_type             AS "mc_contactType"
       , mc.first_name               AS "mc_firstName"
       , mc.last_name                AS "mc_lastName"
       , mc.email                    AS "mc_email"
       , mc.birth_date               AS "mc_birthDate"
       , mc.version                  AS "mc_version"
       , true                        AS "di_isLocked"
   FROM t_drill_item di
   JOIN t_drill_group dg ON dg.id = di.drill_group_id
   LEFT JOIN t_drill dr ON dr.drill_item_id = di.id
        AND dr.user_id = :athleteUserId
   LEFT JOIN t_media m on m.id = dr.media_id
   LEFT JOIN t_user cu ON cu.id = dr.created_by_id
   LEFT JOIN t_contact cc ON cc.id = cu.contact_id
   LEFT JOIN t_user mu ON mu.id = dr.modified_by_id
   LEFT JOIN t_contact mc ON mc.id = mu.contact_id
  WHERE dg.id = :drillGroupId
    AND di.level_index = :levelIndex
  ORDER BY di.order_index
>>

getCompletedByAthleteWithFilters(tagCodes) ::= <<
  SELECT di.id                       AS "di_drillItemId"
       , di.team_id                  AS "di_teamId"
       , di.name                     AS "di_name"
       , di.description              AS "di_description"
       , di.media_id                 AS "di_mediaId"
       , di.level_index              AS "di_levelIndex"
       , di.level_test               AS "di_levelTest"
       , di.drill_item_order         AS "di_drillItemOrder"
       , di.passing_score            AS "di_passingScore"
       , di.shots_max                AS "di_shotsMax"
       , di.media_thumbnail          AS "di_mediaThumbnail"
       , di.order_index              AS "di_orderIndex"
       , di.visibility_code          AS "di_visibilityCode"
       , di.allow_retry_code         AS "di_allowRetryCode"
       , di.retry_max                AS "di_retryMax"
       , di.time_limit_ms            AS "di_timeLimitMs"
       , dg.id                       AS "dg_id"
       , dg.team_id                  AS "dg_teamId"
       , dg.name                     AS "dg_name"
       , dg.description              AS "dg_description"
       , dg.drill_group_order        AS "dg_drillGroupOrder"
       , dg.drill_group_type_code    AS "dg_drillGroupTypeCode"
       , dg.creation_date            AS "dg_creationDate"
       , dg.modification_date        AS "dg_modificationDate"
       , dg.created_by_id            AS "dg_createdById"
       , dg.modified_by_id           AS "dg_modifiedById"
       , dg.version                  AS "dg_version"
       , dr.id                       AS "dr_id"
       , dr.drill_item_id            AS "dr_drillItemId"
       , dr.user_id                  AS "dr_userId"
       , dr.media_id                 AS "dr_mediaId"
       , m.status_code               AS "dr_mediaStatus"
       , dr.drill_status             AS "dr_drillStatus"
       , dr.attempts_detected        AS "dr_attemptsDetected"
       , dr.attempts_reported        AS "dr_attemptsReported"
       , dr.makes_detected           AS "dr_makesDetected"
       , dr.makes_reported           AS "dr_makesReported"
       , dr.creation_date            AS "dr_creationDate"
       , dr.modification_date        AS "dr_modificationDate"
       , dr.created_by_id            AS "dr_createdById"
       , dr.modified_by_id           AS "dr_modifiedById"
       , dr.version                  AS "dr_version"
       , cu.id                       AS "cu_userId"
       , cu.email                    AS "cu_email"
       , cu.user_alias               AS "cu_userAlias"
       , cu.username                 AS "cu_username"
       , cc.id                       AS "cc_id"
       , cc.contact_type             AS "cc_contactType"
       , cc.first_name               AS "cc_firstName"
       , cc.last_name                AS "cc_lastName"
       , cc.email                    AS "cc_email"
       , cc.birth_date               AS "cc_birthDate"
       , cc.version                  AS "cc_version"
       , mu.id                       AS "mu_userId"
       , mu.email                    AS "mu_email"
       , mu.user_alias               AS "mu_userAlias"
       , mu.username                 AS "mu_username"
       , mc.id                       AS "mc_id"
       , mc.contact_type             AS "mc_contactType"
       , mc.first_name               AS "mc_firstName"
       , mc.last_name                AS "mc_lastName"
       , mc.email                    AS "mc_email"
       , mc.birth_date               AS "mc_birthDate"
       , mc.version                  AS "mc_version"
       , true                        AS "di_isLocked"
   FROM t_drill_item di
   JOIN t_drill_group dg ON dg.id = di.drill_group_id
   JOIN t_drill dr ON dr.drill_item_id = di.id
        AND dr.user_id = :athleteUserId
   LEFT JOIN t_media m ON m.id = dr.media_id
   JOIN t_user cu ON cu.id = dr.created_by_id
   JOIN t_contact cc ON cc.id = cu.contact_id
   JOIN t_user mu ON mu.id = dr.modified_by_id
   JOIN t_contact mc ON mc.id = mu.contact_id
  WHERE dr.drill_status = 'COMPLETE'
  <if(tagCodes)>
    AND di.id IN (
        SELECT dit.drill_item_id
          FROM t_drill_item_tag dit
          JOIN t_tag t ON t.id = dit.tag_id
         WHERE t.code IN (:tagCodes)
         GROUP BY dit.drill_item_id
        HAVING COUNT(DISTINCT t.code) = <length(tagCodes)>
    )
  <endif>
  ORDER BY dr.creation_date DESC
  LIMIT :limit OFFSET :offset
>>