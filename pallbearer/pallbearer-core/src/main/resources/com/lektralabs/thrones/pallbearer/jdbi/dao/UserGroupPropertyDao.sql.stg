group UserGroupPropertyDao;

insert() ::= <<
INSERT INTO t_user_drill_group_property (
    id,
    user_id,
    drill_group_id,
    property_key,
    property_value
) VALUES (
    :id,
    :userId,
    :drillGroupId,
    :propertyKey,
    :propertyValue
);
>>

update() ::= <<
UPDATE t_user_drill_group_property
SET property_value = :propertyValue
WHERE user_id = :userId
  AND drill_group_id = :drillGroupId
  AND property_key = :propertyKey;
>>

delete() ::= <<
DELETE FROM t_user_drill_group_property
WHERE id = :id;
>>

selectById() ::= <<
SELECT * FROM t_user_drill_group_property
WHERE id = :id;
>>

selectAllByUserAndGroup() ::= <<
SELECT * FROM t_user_drill_group_property
WHERE user_id = :userId
  AND drill_group_id = :drillGroupId;
>>

selectAllByUserId() ::= <<
SELECT * FROM t_user_drill_group_property
WHERE user_id = :userId;
>>

selectAllByUserIds(userIds) ::= <<
SELECT * FROM t_user_drill_group_property
WHERE user_id IN (<userIds>);
>>

deleteAllByUserIdAndGroup() ::= <<
DELETE FROM t_user_drill_group_property
WHERE user_id = :userId
  AND drill_group_id = :drillGroupId;
>>

selectByUserGroupAndKey() ::= <<
SELECT * FROM t_user_drill_group_property
WHERE user_id = :userId
  AND drill_group_id = :drillGroupId
  AND property_key = :key;
>>

deleteByUserGroupAndKey() ::= <<
DELETE FROM t_user_drill_group_property
WHERE user_id = :userId
  AND drill_group_id = :drillGroupId
  AND property_key = :propertyKey;
>>

deleteByUserIdAndKey() ::= <<
DELETE FROM t_user_drill_group_property
WHERE user_id = :userId
  AND property_key = :key;
>>