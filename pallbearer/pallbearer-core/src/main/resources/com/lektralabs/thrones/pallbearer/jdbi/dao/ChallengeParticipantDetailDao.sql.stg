group ChallengeParticipantDetailDao;

selectByChallengeId() ::= <<
  SELECT cp.id
       , cp.participant_user_id      AS "cp_challengeParticipantId"
       , cp.challenge_id             AS "cp_challengeId"
       , cp.participant_role_code    AS "cp_participantRoleCode"
       , u.id                       AS "u_userId"
       , u.email                    AS "u_email"
       , u.user_alias               AS "u_userAlias"
       , u.username                 AS "u_username"
       , c.id                       AS "c_contactId"
       , c.contact_type             AS "c_contactType"
       , c.first_name               AS "c_firstName"
       , c.last_name                AS "c_lastName"
       , c.email                    AS "c_email"
       , c.birth_date               AS "c_birthDate"
       , c.version                  AS "c_version"
    FROM t_challenge_participant cp
    JOIN t_user u on u.id = cp.participant_user_id
    JOIN t_contact c on c.id = u.contact_id
   WHERE cp.challenge_id = :challengeId;
>>
