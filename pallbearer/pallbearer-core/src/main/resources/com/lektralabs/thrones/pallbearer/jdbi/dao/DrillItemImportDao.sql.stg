group DrillItemImportDao;

comment() ::= <<
<! // This file is meant to be customized. !>
>>

select() ::= <<
     SELECT id
          , drill_group_id
          , name
          , description
          , media_id
          , media_thumbnail
          , level_index
          , drill_item_order
          , order_index
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , team_id
          , shots_max
          , unique_id
       FROM t_drill_item_import
      WHERE id = :id
>>

selectAll(findOptions) ::= <<
     SELECT *
       FROM t_drill_item_import
     <findOptions>
>>

findByUniqueId() ::= <<
     SELECT id
          , drill_group_id
          , name
          , description
          , media_id
          , media_thumbnail
          , level_index
          , drill_item_order
          , order_index
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , team_id
          , shots_max
          , unique_id
       FROM t_drill_item_import
      WHERE unique_id = :uniqueId
>>

insert() ::= <<
     INSERT INTO t_drill_item_import (
            id
          , drill_group_id
          , name
          , description
          , media_id
          , media_thumbnail
          , level_index
          , drill_item_order
          , order_index
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , team_id
          , shots_max
          , unique_id
     ) VALUES (
            :id
          , :drillGroupId
          , :name
          , :description
          , :mediaId
          , :mediaThumbnail
          , :levelIndex
          , :drillItemOrder
          , :orderIndex
          , :passingScore
          , :visibilityCode
          , :allowRetryCode
          , :retryMax
          , :timeLimitMs
          , :creationDate
          , :modificationDate
          , :createdById
          , :modifiedById
          , :version
          , :levelTest
          , :teamId
          , :shotsMax
          , :uniqueId
     )
>>

update() ::= <<
     UPDATE t_drill_item_import
        SET drill_group_id = :drillGroupId
          , name = :name
          , description = :description
          , media_id = :mediaId
          , media_thumbnail = :mediaThumbnail
          , level_index = :levelIndex
          , drill_item_order = :drillItemOrder
          , order_index = :orderIndex
          , passing_score = :passingScore
          , visibility_code = :visibilityCode
          , allow_retry_code = :allowRetryCode
          , retry_max = :retryMax
          , time_limit_ms = :timeLimitMs
          , modification_date = :modificationDate
          , modified_by_id = :modifiedById
          , version = :version + 1
          , level_test = :levelTest
          , team_id = :teamId
          , shots_max = :shotsMax
          , unique_id = :uniqueId
      WHERE id = :id
        AND version = :version
>>

delete() ::= <<
      DELETE FROM t_drill_item_import WHERE id = :id
>>

deleteAll() ::= <<
      DELETE FROM t_drill_item_import
>>

deleteAllFromProduction() ::= <<
      DELETE FROM t_drill_item
>>

migrateToProduction() ::= <<
      INSERT INTO t_drill_item (
            id
          , drill_group_id
          , name
          , description
          , media_id
          , media_thumbnail
          , level_index
          , drill_item_order
          , order_index
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , team_id
          , shots_max
          , unique_id
      )
      SELECT id
          , drill_group_id
          , name
          , description
          , CASE WHEN media_id IS NULL OR media_id = '' THEN NULL ELSE CAST(media_id AS UUID) END
          , media_thumbnail
          , level_index
          , drill_item_order
          , order_index
          , passing_score
          , visibility_code
          , allow_retry_code
          , retry_max
          , time_limit_ms
          , creation_date
          , modification_date
          , created_by_id
          , modified_by_id
          , version
          , level_test
          , team_id
          , shots_max
          , unique_id
       FROM t_drill_item_import
>>

findAllWithGroupNames() ::= <<
     SELECT di.id
          , di.drill_group_id
          , di.name
          , di.description
          , di.media_id
          , di.media_thumbnail
          , di.level_index
          , di.drill_item_order
          , di.order_index
          , di.passing_score
          , di.visibility_code
          , di.allow_retry_code
          , di.retry_max
          , di.time_limit_ms
          , di.creation_date
          , di.modification_date
          , di.created_by_id
          , di.modified_by_id
          , di.version
          , di.level_test
          , di.team_id
          , di.shots_max
          , di.unique_id
          , dg.name AS drill_group_name
       FROM t_drill_item_import di
       JOIN t_drill_group dg ON dg.id = di.drill_group_id
>>

updateMediaThumbnail() ::= <<
     UPDATE t_drill_item_import
        SET media_thumbnail = :mediaThumbnail
          , modification_date = :modificationDate
      WHERE id = :id
>>

updateMediaThumbnailPathPrefix() ::= <<
     UPDATE t_drill_item_import
        SET media_thumbnail = REPLACE(media_thumbnail, :oldPathPrefix, :newPathPrefix)
          , modification_date = :modificationDate
      WHERE media_thumbnail LIKE :oldPathPrefix || '%'
>>
